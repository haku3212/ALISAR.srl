{
  "name": "alisar-desktop",
  "version": "1.0.0",
  "description": "ALISAR - Sistema de Gestión de Recursos Forestales",
  "main": "public/electron.js",
  "author": "ALISAR SRL",
  "license": "ISC",
  "homepage": "./",
  "scripts": {
    "dev": "concurrently \"npm run start --prefix frontend\" \"npm run start --prefix backend\"",
    "start": "react-scripts start --prefix frontend",
    "build:frontend": "npm run build --prefix frontend",
    "build:backend": "echo 'Backend is ready'",
    "build": "npm run build:frontend && npm run build:backend",
    "electron": "electron .",
    "electron-dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron . --dev\"",
    "preelectron-pack": "npm run build",
    "electron-pack": "electron-builder --publish never",
    "electron-build": "npm run build && electron-builder -w",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "concurrently": "^8.2.1",
    "electron": "^28.0.0",
    "electron-builder": "^24.6.4",
    "electron-is-dev": "^2.0.0",
    "pdfkit": "^0.19.1",
    "playwright": "^1.61.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.alisar.desktop",
    "productName": "ALISAR",
    "directories": {
      "buildResources": "assets"
    },
    "files": [
      "public/electron.js",
      "public/preload.js",
      "frontend/build/**/*",
      "backend/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ALISAR"
    }
  }
}
